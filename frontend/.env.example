# Flutter build/run defines (pass these into your build command).
#
# The web app only needs the backend URL. Build with:
#   flutter build web --no-tree-shake-icons --dart-define=BACKEND_URL=http://localhost:8002
#
# Replace localhost with your server IP when deploying remotely, e.g.
#   --dart-define=BACKEND_URL=http://192.168.100.100:8002

BACKEND_URL=http://localhost:8002
