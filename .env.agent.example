# Rased agent (additional machine / LXC). Copy:  cp .env.agent.example .env.agent
# It POSTs metrics to the CENTRAL node and appears as a new tab.

RASED_API_PORT=8002

# Identity — MUST be unique per machine
RASED_HOST_ID=lxc-2
RASED_HOST_NAME=LXC 2
# Externally reachable URL of THIS agent (so the dashboard can manage it)
RASED_PUBLIC_BASE_URL=http://THIS_LXC_IP:8002

# ---------- Link to the CENTRAL node ----------
CENTRAL_INGEST_URL=http://CENTRAL_IP:8002
AGENT_TOKEN=<same AGENT_TOKEN as the central .env>
JWT_SECRET=<same JWT_SECRET as the central .env>
RASED_CORS_ORIGINS=http://CENTRAL_IP:8082

# ---------- Optional ----------
NUT_HOST=host.docker.internal
NUT_PORT=3493
NUT_UPS_NAME=ups
UPTIME_CHECKS=
ALERT_WEBHOOK_URL=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
