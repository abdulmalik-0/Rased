# Rased agent (additional machine / LXC) — points at your CENTRAL Supabase.
# Copy to .env on the new machine:  cp .env.agent.example .env

RASED_API_PORT=8002

# Identity — MUST be unique per machine
RASED_HOST_ID=lxc-2
RASED_HOST_NAME=LXC 2
# Externally reachable URL of THIS agent (so the dashboard can manage its containers)
RASED_PUBLIC_BASE_URL=http://192.168.100.XX:8002

# Central Supabase (the machine running the full Rased stack)
SUPABASE_URL=http://192.168.100.100:8003
SERVICE_ROLE_KEY=<same SERVICE_ROLE_KEY as the central .env>
JWT_SECRET=<same JWT_SECRET as the central .env>
SUPABASE_BROADCAST_CHANNEL=server-metrics

# Allow the dashboard origin to call this agent
RASED_CORS_ORIGINS=http://192.168.100.100:8082

# Optional
NUT_HOST=host.docker.internal
NUT_PORT=3493
NUT_UPS_NAME=ups
ALERT_WEBHOOK_URL=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
