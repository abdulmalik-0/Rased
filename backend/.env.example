# Rased API — local development (outside Docker)
# Copy: cp .env.example .env

# Supabase (local self-hosted on host port 8003)
SUPABASE_URL=http://localhost:8003
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
# JWT secret — must match Supabase JWT_SECRET (used to verify user tokens for admin actions)
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_BROADCAST_CHANNEL=server-metrics

# When running INSIDE docker-compose, use http://kong:8000 instead (set automatically)

# Server identity (shows in the UI; unique per host for multi-server setups)
HOST_ID=default
HOST_NAME=My Server

HOST=0.0.0.0
PORT=8002
METRICS_INTERVAL_SECONDS=3

# NUT / UPS (optional)
NUT_HOST=localhost
NUT_PORT=3493
NUT_UPS_NAME=ups

CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# ---------- Alerting (POSTs JSON to any webhook: n8n, Telegram-via-n8n, Slack…) ----------
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=600
CPU_ALERT_PERCENT=90
MEM_ALERT_PERCENT=90
DISK_ALERT_PERCENT=85
BATTERY_ALERT_PERCENT=30
PROACTIVE_TRIAGE_ENABLED=true

# ---------- Uptime / SSL checks ----------
# "Name|https://url, Name2|https://url2"  (name optional)
UPTIME_CHECKS=
UPTIME_INTERVAL_SECONDS=60
UPTIME_TIMEOUT_SECONDS=10
SSL_ALERT_DAYS=14

# ---------- History persistence (downsampled snapshots -> Supabase) ----------
HISTORY_ENABLED=true
HISTORY_INTERVAL_SECONDS=60

# ---------- Server-side AI (autonomous digest + proactive triage) ----------
# Leave empty to disable; on-demand /analyze still uses the per-user config.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# ---------- Daily AI health digest (sent to ALERT_WEBHOOK_URL) ----------
DIGEST_ENABLED=false
DIGEST_HOUR_UTC=8
