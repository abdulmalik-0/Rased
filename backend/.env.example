# Rased agent — local development (outside Docker). Copy: cp .env.example .env

# SQLite path (central node only). Use a writable local path for dev.
DB_PATH=./rased.db

# Identity
HOST_ID=default
HOST_NAME=My Server
PUBLIC_BASE_URL=http://localhost:8002

HOST=0.0.0.0
PORT=8002
METRICS_INTERVAL_SECONDS=3

# Secrets (CHANGE in production)
JWT_SECRET=change-me-rased-jwt-secret-min-32-characters
ENCRYPTION_KEY=change-me-rased-encryption-key

# Multi-agent: leave empty on the central node.
# On a remote agent set CENTRAL_INGEST_URL + AGENT_TOKEN (shared with central).
AGENT_TOKEN=
CENTRAL_INGEST_URL=

CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# NUT / UPS (optional)
NUT_HOST=localhost
NUT_PORT=3493
NUT_UPS_NAME=ups

# Alerting / uptime / AI (optional)
ALERT_WEBHOOK_URL=
UPTIME_CHECKS=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
DIGEST_ENABLED=false
