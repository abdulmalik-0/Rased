############
# Rased — CENTRAL node. Copy to .env:  cp .env.example .env
# SQLite inside the agent — no external database.
############

RASED_API_PORT=8002
RASED_UI_PORT=8082
RASED_CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,http://YOUR_SERVER_IP:8082

# Identity (shown in UI)
RASED_HOST_ID=default
RASED_HOST_NAME=My Server
RASED_PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8002

# ---------- Secrets — CHANGE THESE ----------
JWT_SECRET=change-me-rased-jwt-secret-min-32-characters
ENCRYPTION_KEY=change-me-rased-encryption-key
# Shared secret for REMOTE agents posting metrics (only if you add machines)
AGENT_TOKEN=change-me-agent-shared-token

METRICS_INTERVAL_SECONDS=3

# ---------- NUT / UPS (optional) ----------
NUT_HOST=host.docker.internal
NUT_PORT=3493
NUT_UPS_NAME=ups

# ---------- Alerting (optional) ----------
# Webhook auto-detects Slack / Discord format; any other URL gets a generic JSON.
ALERT_WEBHOOK_URL=
# Optional Telegram channel (in addition to the webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=600
CPU_ALERT_PERCENT=90
MEM_ALERT_PERCENT=90
DISK_ALERT_PERCENT=85
BATTERY_ALERT_PERCENT=30
PROACTIVE_TRIAGE_ENABLED=true

# ---------- Uptime / SSL (optional): "Name|https://url, Name2|https://url2" ----------
UPTIME_CHECKS=
UPTIME_INTERVAL_SECONDS=60
SSL_ALERT_DAYS=14

# ---------- History ----------
HISTORY_ENABLED=true
HISTORY_INTERVAL_SECONDS=60

# ---------- Server-side AI (optional: daily digest + proactive triage) ----------
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
DIGEST_ENABLED=false
DIGEST_HOUR_UTC=8

# ---------- AI-assisted container install ----------
# Admin describes a service; the AI plans it; the admin reviews and clicks Install
# (runs via the Docker SDK). Set to false to disable the Install button entirely.
ALLOW_CONTAINER_DEPLOY=true

# Per-user monthly AI token budget (0 = unlimited).
AI_MONTHLY_TOKEN_BUDGET=0
